# Claude
.claude/
CLAUDE.local.md
.mcp.json

# Temp (patches, experiments)
temp/

# macOS
.DS_Store
**/.DS_Store
**/._.DS_Store

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
venv/
.venv/
env/
.env
*.egg-info/
dist/
build/

# Node
node_modules/
frontend/coverage/
npm-debug.log*

# Database
*.db
*.db-journal
*.db-wal
*.db-shm

# Archive files (user data)
archive/

# Firmware cache (downloaded firmware files)
firmware/

# Virtual printer (auto-generated certs and uploads at repo root)
/virtual_printer/

plate_calibration/

# IDE
.idea/
.vscode/
*.swp
*.swo

# Screenshots (development - root folder only)
/screenshots/

# Logs — `*.log*` also covers rotated files (bambutrack.log.1, …)
*.log*
logs/

/data/

# But include backend app data (locale JSONs, field definitions)
!backend/app/data/

# JWT secret file (should be in data dir, but protect project root too)
.jwt_secret
# MFA encryption key file (auto-generated on first startup if not set via env)
.mfa_encryption_key

# Security scan output
*.sarif

debug_logs/
site/

# Local tool wrapper binaries (npm-installed CLIs, pip --user scripts) that
# some dev setups drop into a repo-local bin/ — never part of the source tree.
bin/

# Internal planning docs (specs, plans, design exploration). Local workflow
# artifacts; not part of the public repo.
#
# ⚠️ Scoped to the subfolder on purpose. This used to be a bare `docs/`, which
# meant the repo could never carry a public docs directory at all — the first
# place a contributor looks.
docs/superpowers/
graphify-out/

# Subagent-driven-development scratch (ledger, briefs, review packages).
.superpowers/
.playwright-mcp/

# git worktrees for parallel passes (superpowers:using-git-worktrees)
.worktrees/

# design-sync (Claude Design) — staged converter, build output, machine state
.ds-sync/
ds-bundle/
.design-sync/
.codex/
